  m_Name: structured_cabling
  m_EditorClassIdentifier: Assembly-CSharp::Modules.Module02_RackInstallation.Data.RackComponentInfo
  id: structured_cabling
  displayName: Cableado estructurado
  category: 5
  educationalApproximation: 1
  shortDescription: Grupo simplificado de latiguillos de cobre dentro del rack.
  function: "Conecta puertos del patch panel con switches y otros dispositivos manteniendo
    identificaci\xF3n y orden."
  rackUnits: 1
  image: {fileID: 0}
  standardReference: "La instalaci\xF3n real debe respetar categor\xEDa, radio de
    curvatura, longitud y etiquetado del sistema."
  sections:
  - title: Orden, etiquetado y curvatura
    body: "El cableado estructurado conecta el patch panel con switches y otros equipos
      mediante latiguillos de cobre. Cada enlace debe etiquetarse en ambos extremos
      para facilitar la identificaci\xF3n y el mantenimiento. Usar organizadores,
      evitar tensi\xF3n excesiva y respetar el radio de curvatura recomendado para
      no afectar el desempe\xF1o del enlace."
    image: {fileID: 0}
    reference: "ANSI/TIA-568.2-D \u2014 Cableado balanceado de par trenzado; ANSI/TIA-606-C
      \u2014 Administraci\xF3n e identificaci\xF3n de infraestructura."
