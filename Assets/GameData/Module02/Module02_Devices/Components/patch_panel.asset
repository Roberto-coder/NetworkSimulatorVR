  m_Script: {fileID: 11500000, guid: 5563bbff71e9e2e418ccdb0a2ede6316, type: 3}
  m_Name: patch_panel
  m_EditorClassIdentifier: Assembly-CSharp::Modules.Module02_RackInstallation.Data.RackComponentInfo
  id: patch_panel
  displayName: Patch Panel Ethernet 1U
  category: 10
  educationalApproximation: 1
  shortDescription: Panel de parcheo de 24 puertos para conexiones Ethernet mediante
    cable de par trenzado blindado.
  function: Organiza y centraliza el cableado Ethernet para conectarlo de forma ordenada
    al switch mediante puertos RJ45
  rackUnits: 1
  image: {fileID: 0}
  standardReference: "La categor\xEDa y el desempe\xF1o del enlace dependen del sistema
    de cableado instalado."
  sections:
  - title: "Categor\xEDa y terminaci\xF3n"
    body: "El panel ocupa 1U, equivalente a 1.75 pulgadas de altura nominal en un
      rack de 19 pulgadas. Sus puertos RJ45 terminan cables de par trenzado mediante
      conectores tipo IDC. La categor\xEDa del panel, los cables y los latiguillos
      debe ser compatible \u2014por ejemplo, Cat 5e, Cat 6 o Cat 6A\u2014 para conservar
      el rendimiento del enlace. Etiquetar cada puerto y mantener el radio de curvatura
      recomendado facilita el mantenimiento."
    image: {fileID: 0}
    reference: ANSI/EIA-310-E; ANSI/TIA-568.2-D.
