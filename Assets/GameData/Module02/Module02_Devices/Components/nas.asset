  m_Script: {fileID: 11500000, guid: 5563bbff71e9e2e418ccdb0a2ede6316, type: 3}
  m_Name: nas
  m_EditorClassIdentifier: Assembly-CSharp::Modules.Module02_RackInstallation.Data.RackComponentInfo
  id: NAS
  displayName: NAS 2U
  category: 8
  educationalApproximation: 1
  shortDescription: "Sistema de almacenamiento en red para rack con 12 bah\xEDas
    para discos."
  function: Centraliza y almacena archivos, copias de seguridad y datos para que
    puedan ser compartidos y administrados desde la red.
  rackUnits: 2
  image: {fileID: 0}
  standardReference: 2U equivalen a 88.9 mm de altura nominal.
  sections:
  - title: Almacenamiento y respaldo
    body: 'El NAS ocupa 2U, equivalentes a 3.5 pulgadas de altura nominal en un rack
      de 19 pulgadas. Sus discos pueden configurarse con RAID para mantener la disponibilidad
      ante la falla de una unidad; sin embargo, RAID no sustituye una copia de seguridad.
      Se recomienda aplicar la regla 3-2-1: conservar tres copias de los datos, en
      dos medios distintos y una copia fuera del sitio o desconectada.'
    image: {fileID: 0}
    reference: "ANSI/EIA-310-E; NIST SP 800-34 Rev. 1 \u2014 Contingency Planning
      Guide."
