  m_Script: {fileID: 11500000, guid: 5563bbff71e9e2e418ccdb0a2ede6316, type: 3}
  m_Name: switch_overview
  m_EditorClassIdentifier: Assembly-CSharp::Modules.Module02_RackInstallation.Data.RackComponentInfo
  id: switch_overview
  displayName: Switch educativo de 12 puertos
  category: 1
  educationalApproximation: 1
  shortDescription: Modelo simplificado inspirado en switches Cisco; no representa
    un producto exacto.
  function: "Interconecta dispositivos de una red local y reenv\xEDa tramas hacia
    el puerto correspondiente."
  rackUnits: 1
  image: {fileID: 0}
  standardReference: 
  sections:
  - title: "Conmutaci\xF3n y tabla MAC"
    body: "El switch aprende las direcciones MAC de los equipos conectados y las
      registra en una tabla asociada a sus puertos. Cuando recibe una trama, la reenv\xEDa
      \xFAnicamente al puerto donde se encuentra el destino conocido; si no conoce
      el destino, la distribuye por los dem\xE1s puertos de la misma red. Puede separar
      la red en VLAN para mejorar la organizaci\xF3n y el aislamiento del tr\xE1fico."
    image: {fileID: 0}
    reference: "IEEE 802.3 \u2014 Ethernet; IEEE 802.1Q \u2014 VLAN."
