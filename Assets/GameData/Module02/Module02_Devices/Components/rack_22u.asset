  m_Script: {fileID: 11500000, guid: 5563bbff71e9e2e418ccdb0a2ede6316, type: 3}
  m_Name: rack_22u
  m_EditorClassIdentifier: Assembly-CSharp::Modules.Module02_RackInstallation.Data.RackComponentInfo
  id: rack_22u
  displayName: Rack educativo de 22U
  category: 0
  educationalApproximation: 1
  shortDescription: Estructura destinada a organizar y proteger equipos de telecomunicaciones.
  function: Mantiene los dispositivos montados, ordenados y accesibles. Una unidad
    U equivale a 44.45 mm de altura.
  rackUnits: 22
  image: {fileID: 21300000, guid: fcb3af1d41e4f4543a132c49997176dd, type: 3}
  standardReference: "IEC 60297 (dimensiones mec\xE1nicas de estructuras de 19 pulgadas)"
  sections:
  - title: Espaciado y acceso
    body: "Instalar el rack dejando, como criterio educativo, al menos 1 m de espacio
      libre al frente y en la parte posterior para permitir mantenimiento, ventilaci\xF3n
      y acceso al cableado. La separaci\xF3n exacta debe ajustarse a las instrucciones
      del fabricante, el dise\xF1o del sitio y la normativa el\xE9ctrica local."
    image: {fileID: 0}
    reference: ANSI/TIA-569; ANSI/TIA-942; ASHRAE TC 9.9.
  - title: Capacidad y montaje
    body: "El rack ofrece 22U de espacio \xFAtil. Cada unidad U equivale a 1.75 pulgadas
      de altura, por lo que la capacidad nominal de montaje es de 38.5 pulgadas.
      Distribuir los equipos m\xE1s pesados en la zona inferior, asegurar cada dispositivo
      con la torniller\xEDa adecuada y equilibrar la carga para mantener la estabilidad
      del rack."
    image: {fileID: 0}
    reference: IEC 60297; ANSI/EIA-310-E.
