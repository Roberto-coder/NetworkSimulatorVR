  m_Script: {fileID: 11500000, guid: 5563bbff71e9e2e418ccdb0a2ede6316, type: 3}
  m_Name: pdu
  m_EditorClassIdentifier: Assembly-CSharp::Modules.Module02_RackInstallation.Data.RackComponentInfo
  id: PDU
  displayName: PDU 1U
  category: 11
  educationalApproximation: 1
  shortDescription: "Unidad de distribuci\xF3n de energ\xEDa para rack, con 24 tomas
    de corriente y medidor integrado."
  function: "Centraliza la alimentaci\xF3n de los dispositivos conectados y permite
    visualizar el voltaje y la corriente consumida."
  rackUnits: 1
  image: {fileID: 0}
  standardReference: "La capacidad, protecciones y conexi\xF3n deben seguir la documentaci\xF3n
    el\xE9ctrica del equipo."
  sections:
  - title: "Carga y seguridad el\xE9ctrica"
    body: "La PDU distribuye energ\xEDa a los equipos del rack y permite supervisar
      el consumo. Antes de conectar dispositivos, verificar el voltaje, tipo de enchufe
      y capacidad m\xE1xima de corriente de la PDU y del circuito el\xE9ctrico. Distribuir
      la carga entre las tomas y no superar la capacidad nominal. Para equipos cr\xEDticos,
      conectar la PDU a una UPS y etiquetar cada salida."
    image: {fileID: 0}
    reference: "IEC 62368-1 \u2014 Seguridad de equipos de tecnolog\xEDa de la informaci\xF3n
      y comunicaci\xF3n."
